TOKEN=                             # Discord bot token
GUILD_ID=                            # Optional; faster slash-command registration for one server
ADMIN_ROLE_ID=                       # Optional role allowed to manage products and stock
ADMIN_CHANNEL_ID=                    # Optional channel for payment/delivery alerts
MP_ACCESS_TOKEN=                     # Mercado Pago access token
MP_WEBHOOK_SECRET=                   # Signing secret from the Mercado Pago webhook settings
MP_WEBHOOK_URL=https://your-domain.example/webhooks/mercadopago
MP_CURRENCY_ID=BRL
MP_COLLECTOR_ID=                     # Required: your Mercado Pago account/collector ID
PORT=3000
